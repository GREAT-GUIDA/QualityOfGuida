		DisplayName: Torcherino
		Tooltip: Accelerates tile updates
	}

	BoneMealItem: {
		DisplayName: Bone Meal
		Tooltip: Grows plants
	}

	SpawnEggItem: {
		DisplayName: Spawn Egg
		EmptyDisplayName: Empty Spawn Egg
