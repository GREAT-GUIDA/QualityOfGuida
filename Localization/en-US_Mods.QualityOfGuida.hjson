		Tooltip: Spawns enemies
	}

	SpawnerItem: {
		DisplayName: Spawner
		Tooltip: Place and load with spawn eggs to activate
		SetSpawner: Spawner set to {0}
	}

	NameTagItem: {
		DisplayName: Name Tag
		Tooltip:
			'''
			Left-click to name NPCs
			Named non-boss creatures won't naturally despawn
			Right-click to edit content
			Not consumed
			'''
	}
}

